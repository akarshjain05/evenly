{
  "builds": [
    {
      "src": "app/main.py",
      "use": "@vercel/python",
      "config": {
        "includeFiles": "app/static/**"
      }
    },
    {
      "src": "app/static/**",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "app/main.py"
    },
    {
      "src": "/(app\\.js|style\\.css|manifest\\.json|service-worker\\.js)",
      "dest": "/app/static/$1"
    },
    {
      "src": "/icons/(.*)",
      "dest": "/app/static/icons/$1"
    },
    {
      "src": "/(.*)",
      "dest": "app/main.py"
    }
  ]
}