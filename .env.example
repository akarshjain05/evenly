# Copy this file to .env for local overrides (optional).
#
# Leave DATABASE_URL unset for local development - the app will use a
# SQLite file (evenly.db) created next to this folder automatically.
#
# For production (Render), set this to your Neon connection string.
# Get it from the Neon dashboard: your project -> Connection Details.
# It looks like: postgresql://user:password@ep-xxxx.neon.tech/dbname?sslmode=require
DATABASE_URL=

# Secret key for JWT authentication
JWT_SECRET_KEY=09d25e094faa6ca2556c818166b7a9563b93f7099f6f0f4caa6cf63b88e8d3e7
